# --- MySQL (write/) ---
# Precisam bater com o usuário criado em write/schema.sql
MYSQL_HOST=localhost
# 3307, não 3306: veja o comentário na porta do serviço mysql no docker-compose.yml
MYSQL_PORT=3307
MYSQL_DATABASE=appdb
MYSQL_WRITE_USER=app_writer
MYSQL_WRITE_PASSWORD=writer_pw

# --- Kafka (KafkaReader/) ---
# Precisa bater com a porta exposta pelo serviço "kafka" no docker-compose.yml
KAFKA_BROKER=localhost:9092

# --- Redis (KafkaReader/ + read/) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Portas HTTP dos serviços (essas sim são livres, escolha qualquer porta disponível) ---
PORT=3000
QUERY_PORT=3001
